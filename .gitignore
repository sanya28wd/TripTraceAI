# macOS Finder metadata
.DS_Store

# Never commit staged images or other dataset contents.
api/node_modules/
data/staged/*
data/development/*
data/held_out/*
data/labels/*
!data/staged/.gitkeep
!data/development/.gitkeep
!data/held_out/.gitkeep
!data/labels/.gitkeep

# Safe documentation can be versioned; dataset files remain ignored.
!data/staged/*.md
!data/labels/*.md

# Local API database and uploaded objects (Phase 3). Never commit case data.
api/storage/

# Dataset tooling environment and local review images.
data/.venv/
data/scripts/__pycache__/
data/review/

# Reviewed manifests and numeric annotations; no image bytes.
!data/labels/leftincar-v1/
!data/labels/leftincar-v1/**
